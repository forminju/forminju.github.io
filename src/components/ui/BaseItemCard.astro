---
import Tag from "./Tag.astro";
import Icon from "./Icon.astro";
import { splitAuthors } from "../../utils/authors";

interface Props {
    title: string;
    href: string;
    description?: string;
    date?: string;
    authors?: string;
    extraInput?: string;
    tags?: string[];
    externalUrl?: string;
    externalLabel?: string;
    image?: string;
    showDate?: boolean;
}

const {
    title,
    href,
    description,
    date,
    authors,
    extraInput,
    tags,
    externalUrl,
    externalLabel = "View",
    image,
    showDate = true,
} = Astro.props;

const authorParts = authors ? splitAuthors(authors) : [];
---

<article class="card">
    {
        image && (
            <a href={href} class="card-thumb" aria-hidden="true" tabindex="-1">
                <img src={image} alt={`Thumbnail for ${title}`} loading="lazy" decoding="async" />
            </a>
        )
    }

    <div class="card-content">
        <a href={href} class="card-title">{title}</a>

        <div class="card-meta">
            {extraInput && (
                <span class="flex items-center gap-1">
                    <Icon name="Institution" size={24} />
                    <span>{extraInput}</span>
                </span>
            )}
            {authorParts.length > 0 && (
                <span class="flex items-center gap-1">
                    <Icon name="User" size={24} />
                    <span>{authorParts.map((author, i) => (<span>{i > 0 ? ", " : ""}{author.isSelf ? <strong>{author.name}</strong> : author.name}</span>))}</span>
                </span>
            )}
            {showDate && date && (
                <span class="flex items-center gap-1">
                    <Icon name="Calendar" size={24} />
                    <span>{date}</span>
                </span>
            )}
        </div>

        {
            tags && tags.length > 0 && (
                <div class="flex gap-2 flex-wrap mb-3">
                    {tags.map((tag) => (
                        <Tag name={tag} size="sm" />
                    ))}
                </div>
            )
        }

        {description && <p class="card-desc">{description}</p>}
    </div>

    {
        externalUrl && (
            <div class="flex-shrink-0">
                <a href={externalUrl} target="_blank" rel="noopener noreferrer" class="card-link">
                    {externalLabel}
                </a>
            </div>
        )
    }
</article>
